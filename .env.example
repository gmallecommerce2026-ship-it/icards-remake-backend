NODE_ENV=development
PORT=5000
# --- MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=icards
DB_PASSWORD=doi-mat-khau-db
DB_NAME=icards
# true: tự tạo bảng khi khởi động (dùng cho lần đầu). Khi đã có dữ liệu thật, đặt false
DB_SYNCHRONIZE=true

# --- Auth (JWT lưu trong cookie httpOnly) ---
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=7d
COOKIE_NAME=icards_token
# lax (cùng site / dùng proxy rewrites) | none (khác site, bắt buộc HTTPS). Mặc định: dev=lax, production=none
COOKIE_SAME_SITE=

# --- Frontend ---
# Có thể nhiều origin, ngăn cách bằng dấu phẩy. Origin ĐẦU TIÊN dùng để dựng link trong email.
# Nếu FE deploy dưới basePath (vd /icards-remake) thì ghi luôn: https://user.github.io/icards-remake
FRONTEND_URL=http://localhost:3000
# Đường dẫn trang xem thiệp công khai trên FE -> link email: <FRONTEND_URL><PUBLIC_EVENT_PATH>?id=<slug>&guestId=<token>
PUBLIC_EVENT_PATH=/events/view

# --- Gửi email (Gmail: dùng App Password). Để trống = DRY-RUN, chỉ log link ra console ---
EMAIL_USER=
EMAIL_PASS=

# --- Cloudflare R2 (ảnh). Để trống = tắt upload ảnh ---
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_NAME=
R2_PUBLIC_URL=

# --- Đăng nhập mạng xã hội (Phase sau) ---
CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SESSION_SECRET=
